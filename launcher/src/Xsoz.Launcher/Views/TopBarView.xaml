<UserControl x:Class="Xsoz.Launcher.Views.TopBarView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:Xsoz.Launcher.Controls"
             xmlns:sys="clr-namespace:System;assembly=System.Runtime"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True">

  <!--
    THE TOP BAR, shared by every screen.

    72px tall, the page title in the display face on the left, and on the right the profile chip
    and a compact PLAY. The compact PLAY is the decision that keeps the launcher's first rule
    true: without it, Settings is two clicks away from starting the game.

    Home uses the same bar with no title, because Home's title is the 48px version number inside
    its card and a second, smaller copy of the word "Home" above it would be decoration.
  -->
  <UserControl.Resources>
    <sys:String x:Key="NoTitle"></sys:String>
  </UserControl.Resources>

  <!--
    Stretch, not Centre. The design's topbar is a 960px box with 48px of side padding that sits
    centred in the content area; HorizontalAlignment="Center" would size the bar to its own
    content and put the profile chip wherever the words happened to end, which is how the chip
    ended up sitting on top of the page title.
  -->
  <Border MaxWidth="{StaticResource M.ContentMaxWidth}"
          Height="72"
          Margin="0"
          Padding="48,0,48,0"
          HorizontalAlignment="Stretch"
          SnapsToDevicePixels="True">
    <Grid>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>

    <c:TrackedText x:Name="TitleText"
                   Grid.Column="0"
                   VerticalAlignment="Center"
                   HorizontalAlignment="Left"
                   Text="{Binding Title, RelativeSource={RelativeSource AncestorType=UserControl}}"
                   Tracking="20"
                   DisplayFontFamily="{StaticResource F.Display}"
                   DisplayFontSize="{StaticResource D.32}"
                   DisplayFontWeight="Bold"
                   Foreground="{StaticResource B.Text}"
                   AutomationProperties.AutomationId="PageTitle" />

    <StackPanel Grid.Column="1"
                Orientation="Horizontal"
                VerticalAlignment="Center">
      <!-- The profile chip, on every screen. It is a context chip, like an account name, and it
           is the one click that changes profile. -->
      <Button Style="{StaticResource Chip.Profile}"
              Command="{Binding DataContext.OpenProfilePanelCommand, RelativeSource={RelativeSource AncestorType=Window}}"
              AutomationProperties.AutomationId="ProfileChip"
              AutomationProperties.Name="Open the profile panel">
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
          <TextBlock Text="{Binding DataContext.ProfileChipName, RelativeSource={RelativeSource AncestorType=Window}}"
                     FontSize="{StaticResource U.13}"
                     FontWeight="Medium"
                     Foreground="{StaticResource B.Text}"
                     VerticalAlignment="Center" />
          <Border Width="1" Height="14"
                  Margin="8,0"
                  VerticalAlignment="Center"
                  Background="{StaticResource B.Line}"
                  SnapsToDevicePixels="True" />
          <TextBlock Text="{Binding DataContext.ProfileChipKind, RelativeSource={RelativeSource AncestorType=Window}}"
                     FontSize="{StaticResource U.13}"
                     Foreground="{StaticResource B.Text3}"
                     VerticalAlignment="Center" />
          <Path Width="12" Height="12"
                Margin="8,0,0,0"
                Data="{StaticResource I.Caret}"
                Fill="{StaticResource B.Text3}"
                VerticalAlignment="Center" />
        </StackPanel>
      </Button>

      <Button x:Name="CompactPlay"
              Margin="12,0,0,0"
              Style="{StaticResource Btn.PlayCompact}"
              Command="{Binding DataContext.PlayCommand, RelativeSource={RelativeSource AncestorType=Window}}"
              IsEnabled="{Binding DataContext.PlayEnabled, RelativeSource={RelativeSource AncestorType=Window}}"
              Visibility="{Binding ShowCompactPlay, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource Cv.Bool}}"
              AutomationProperties.AutomationId="CompactPlayButton"
              AutomationProperties.Name="Play">
        <c:TrackedText Text="{Binding DataContext.PlayLabel, RelativeSource={RelativeSource AncestorType=Window}}"
                       Tracking="80"
                       DisplayFontFamily="{StaticResource F.Display}"
                       DisplayFontSize="{StaticResource D.16}"
                       DisplayFontWeight="Bold"
                       VerticalAlignment="Center" />
      </Button>
    </StackPanel>
    </Grid>
  </Border>
</UserControl>
