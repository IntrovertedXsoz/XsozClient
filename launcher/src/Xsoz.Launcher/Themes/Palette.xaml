<!--
  ============================================================================
  THE DESIGN TOKEN SYSTEM. Single source of truth for the whole launcher.
  ============================================================================

  Every value below is transcribed verbatim from the approved design's
  :root custom-property block (ClaudeDesign/design-tokens.html and every
  mockup's identical copy). Nothing in this file is a taste decision, and
  nothing outside this file is allowed to invent a colour, a spacing step, a
  type size or a duration.

    bg #101114  rail #0D0E11  surface #15171C  raised #1A1D23
    hover #1F2329  line #2A3040  line-soft #1E222B  edge #5D677C
    text #ECEEF2  text-2 #A9B0BE  text-3 #7E8799
    accent #4CD765  accent-hover #63E27B  accent-press #3DBB55
    accent-deep #2C8C3F  on-accent #08120B  warn #D4A94F
    spacing: 4 8 12 16 24 32 48 72
    motion:  fade 140ms, cubic-bezier(.2,.7,.2,1)

  THE FOUR DEVIATIONS, and only these four, are values the mockups' own
  stylesheets introduce outside :root. They are listed separately and marked,
  so a reviewer can see at a glance what is contract and what is transcribed
  from a component rule:

    #252A35  empty progress blocks and empty step ticks   (seg-empty)
    #22262F  the disabled fill of a green button            (play-disabled)
    #0B0C0F  the log viewer background                     (log-bg)
    #3A4150  the third square of the brand mark             (mark-dim)
    #13151A  the Home skyline silhouette                    (sky)

  MOTION. WPF has no cubic-bezier() and cannot be given one without a custom
  timing function, so the curve is approximated by CubicEase(.2,.7,.2,1) in
  Themes/Motion.cs: WPF's CubicEase is the same control-point pair, but it
  parameterises x linearly where CSS solves x(t) as a Bezier. Over 140 ms the
  two curves differ by well under a frame of perceptible timing, and the
  close approximation is documented rather than hidden. Reduced motion turns
  every animation off; nothing in this app requires animation to be usable.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime">

  <!-- ====================================================================
       1. COLOUR - the :root contract
       ==================================================================== -->

  <Color x:Key="C.Bg">#101114</Color>
  <Color x:Key="C.Rail">#0D0E11</Color>
  <Color x:Key="C.Surface">#15171C</Color>
  <Color x:Key="C.Raised">#1A1D23</Color>
  <Color x:Key="C.Hover">#1F2329</Color>

  <Color x:Key="C.Line">#2A3040</Color>
  <Color x:Key="C.LineSoft">#1E222B</Color>
  <Color x:Key="C.Edge">#5D677C</Color>

  <Color x:Key="C.Text">#ECEEF2</Color>
  <Color x:Key="C.Text2">#A9B0BE</Color>
  <Color x:Key="C.Text3">#7E8799</Color>

  <Color x:Key="C.Accent">#4CD765</Color>
  <Color x:Key="C.AccentHover">#63E27B</Color>
  <Color x:Key="C.AccentPress">#3DBB55</Color>
  <Color x:Key="C.AccentDeep">#2C8C3F</Color>
  <Color x:Key="C.OnAccent">#08120B</Color>
  <Color x:Key="C.Warn">#D4A94F</Color>

  <!-- Component values from the mockup stylesheets, not from :root. -->
  <Color x:Key="C.SegEmpty">#252A35</Color>
  <Color x:Key="C.Disabled">#22262F</Color>
  <Color x:Key="C.LogBg">#0B0C0F</Color>
  <Color x:Key="C.MarkDim">#3A4150</Color>
  <Color x:Key="C.Sky">#13151A</Color>
  <Color x:Key="C.Focus">#FFFFFF</Color>
  <Color x:Key="C.EdgeHover">#8792A8</Color>
  <Color x:Key="C.EdgeHoverAlt">#7B869C</Color>

  <!-- ====================================================================
       2. BRUSHES
       ==================================================================== -->

  <SolidColorBrush x:Key="B.Bg" Color="{StaticResource C.Bg}" />
  <SolidColorBrush x:Key="B.Rail" Color="{StaticResource C.Rail}" />
  <SolidColorBrush x:Key="B.Surface" Color="{StaticResource C.Surface}" />
  <SolidColorBrush x:Key="B.Raised" Color="{StaticResource C.Raised}" />
  <SolidColorBrush x:Key="B.Hover" Color="{StaticResource C.Hover}" />

  <SolidColorBrush x:Key="B.Line" Color="{StaticResource C.Line}" />
  <SolidColorBrush x:Key="B.LineSoft" Color="{StaticResource C.LineSoft}" />
  <SolidColorBrush x:Key="B.Edge" Color="{StaticResource C.Edge}" />

  <SolidColorBrush x:Key="B.Text" Color="{StaticResource C.Text}" />
  <SolidColorBrush x:Key="B.Text2" Color="{StaticResource C.Text2}" />
  <SolidColorBrush x:Key="B.Text3" Color="{StaticResource C.Text3}" />

  <SolidColorBrush x:Key="B.Accent" Color="{StaticResource C.Accent}" />
  <SolidColorBrush x:Key="B.AccentHover" Color="{StaticResource C.AccentHover}" />
  <SolidColorBrush x:Key="B.AccentPress" Color="{StaticResource C.AccentPress}" />
  <SolidColorBrush x:Key="B.AccentDeep" Color="{StaticResource C.AccentDeep}" />
  <SolidColorBrush x:Key="B.OnAccent" Color="{StaticResource C.OnAccent}" />
  <SolidColorBrush x:Key="B.Warn" Color="{StaticResource C.Warn}" />

  <SolidColorBrush x:Key="B.SegEmpty" Color="{StaticResource C.SegEmpty}" />
  <SolidColorBrush x:Key="B.Disabled" Color="{StaticResource C.Disabled}" />
  <SolidColorBrush x:Key="B.LogBg" Color="{StaticResource C.LogBg}" />
  <SolidColorBrush x:Key="B.MarkDim" Color="{StaticResource C.MarkDim}" />
  <SolidColorBrush x:Key="B.Sky" Color="{StaticResource C.Sky}" />
  <SolidColorBrush x:Key="B.Focus" Color="{StaticResource C.Focus}" />
  <SolidColorBrush x:Key="B.EdgeHover" Color="{StaticResource C.EdgeHover}" />
  <SolidColorBrush x:Key="B.EdgeHoverAlt" Color="{StaticResource C.EdgeHoverAlt}" />

  <!-- rgba() values from the mockup, expressed as the same colour at an opacity. -->
  <SolidColorBrush x:Key="B.AccentWash" Color="{StaticResource C.Accent}" Opacity="0.09" />
  <SolidColorBrush x:Key="B.AccentRing" Color="{StaticResource C.Accent}" Opacity="0.35" />
  <SolidColorBrush x:Key="B.Scrim" Color="#0A0B0E" Opacity="0.8" />
  <SolidColorBrush x:Key="B.TopHighlight" Color="#FFFFFF" Opacity="0.22" />

  <SolidColorBrush x:Key="B.Transparent" Color="Transparent" />

  <!-- ====================================================================
       3. SPACING - s1 through s8, and the two derived page measures
       ==================================================================== -->

  <sys:Double x:Key="Space.1">4</sys:Double>
  <sys:Double x:Key="Space.2">8</sys:Double>
  <sys:Double x:Key="Space.3">12</sys:Double>
  <sys:Double x:Key="Space.4">16</sys:Double>
  <sys:Double x:Key="Space.5">24</sys:Double>
  <sys:Double x:Key="Space.6">32</sys:Double>
  <sys:Double x:Key="Space.7">48</sys:Double>
  <sys:Double x:Key="Space.8">72</sys:Double>

  <sys:Double x:Key="M.ContentMaxWidth">960</sys:Double>
  <sys:Double x:Key="M.PagePad">48</sys:Double>
  <sys:Double x:Key="M.SectionGap">72</sys:Double>
  <sys:Double x:Key="M.RailWidth">224</sys:Double>
  <sys:Double x:Key="M.TitleBarHeight">40</sys:Double>
  <sys:Double x:Key="M.DrawerWidth">480</sys:Double>

  <!-- Shape: radius 0 everywhere, no shadows, no blur, no gradients. -->
  <sys:Double x:Key="M.Radius">0</sys:Double>

  <!-- ====================================================================
       4. MOTION - fade 140ms
       ==================================================================== -->

  <sys:Double x:Key="Motion.FadeMs">140</sys:Double>
  <sys:Double x:Key="Motion.FadeSeconds">0.14</sys:Double>
  <Duration x:Key="Motion.Fade">0:0:0.14</Duration>

  <!-- ====================================================================
       5. HAIRLINES

       Replaced at runtime by Themes/DpiMetrics with 1 / dpiScale, so a hairline
       is exactly one device pixel at 100%, 125% and 150%. The values here are
       the 100% defaults and exist so a resource lookup never fails.
       ==================================================================== -->

  <!-- WPF Thickness is (Left, Top, Right, Bottom). Named by which edge is drawn, not by which
       value is largest, because getting the order wrong draws a box instead of a rule and a box
       on a hairline-only interface is immediately visible as a grid. -->
  <Thickness x:Key="H.Hair">1</Thickness>
  <Thickness x:Key="H.HairTop">1,0,1,0</Thickness>
  <Thickness x:Key="H.HairBottom">0,0,0,1</Thickness>
  <Thickness x:Key="H.HairLeft">0,1,0,1</Thickness>
  <Thickness x:Key="H.HairRight">1,1,1,0</Thickness>
  <Thickness x:Key="H.RuleTop">1,0,1,0</Thickness>
  <Thickness x:Key="H.RuleBottom">0,0,0,1</Thickness>
  <Thickness x:Key="H.None">0</Thickness>

  <!-- A Grid column that is exactly one device pixel wide. The rail's right-hand rule is a
       column rather than a Border so that the content area's width is the shell's width minus
       224 and one pixel, with no rounding drift between the two. -->
  <GridLength x:Key="H.PixelColumn">1px</GridLength>

  <!-- ====================================================================
       6. LEGACY KEY ALIASES

       The pre-port key names, mapped onto the contract values so the two
       files that were not rewritten for the new layout still resolve. Every
       value below points at a contract brush - none of them is a new colour.
       Kept deliberately small: anything a rewritten view needs is spelled
       with the contract key instead.
       ==================================================================== -->

  <SolidColorBrush x:Key="B.Page" Color="{StaticResource C.Bg}" />
  <SolidColorBrush x:Key="B.Panel" Color="{StaticResource C.Surface}" />
  <SolidColorBrush x:Key="B.Sunken" Color="{StaticResource C.Rail}" />
  <SolidColorBrush x:Key="B.Line.Strong" Color="{StaticResource C.Edge}" />
  <SolidColorBrush x:Key="B.Line.Subtle" Color="{StaticResource C.LineSoft}" />
  <SolidColorBrush x:Key="B.Text.Secondary" Color="{StaticResource C.Text2}" />
  <SolidColorBrush x:Key="B.Text.Muted" Color="{StaticResource C.Text3}" />
  <SolidColorBrush x:Key="B.Accent.Dim" Color="{StaticResource C.AccentDeep}" />
  <SolidColorBrush x:Key="B.Accent.Deep" Color="{StaticResource C.AccentDeep}" />
  <SolidColorBrush x:Key="B.Accent.Ink" Color="{StaticResource C.OnAccent}" />
  <SolidColorBrush x:Key="B.Warn.Deep" Color="{StaticResource C.Warn}" Opacity="0.14" />
  <SolidColorBrush x:Key="B.Error" Color="{StaticResource C.Warn}" />
  <SolidColorBrush x:Key="B.Error.Deep" Color="{StaticResource C.Warn}" Opacity="0.14" />
  <SolidColorBrush x:Key="B.TierA" Color="{StaticResource C.Accent}" />
  <SolidColorBrush x:Key="B.TierB" Color="{StaticResource C.Warn}" />
  <SolidColorBrush x:Key="B.TierC" Color="{StaticResource C.Warn}" />
  <SolidColorBrush x:Key="B.TierCDeep" Color="{StaticResource C.Warn}" Opacity="0.14" />

</ResourceDictionary>
